# Optional external image API configuration.
# Copy this file to a private location named .env only after the user chooses
# the external backend. Never package a populated .env file with the skill.
IMG_BASE_URL=https://your-provider.example/v1
IMG_MODEL=your-image-model
IMG_API_KEY=your-api-key
# Optional: sync or async. If omitted, the helper infers a mode when possible.
IMG_API_MODE=sync
